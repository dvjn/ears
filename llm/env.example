# ears-llm settings. Copy to ~/.config/ears-llm/env and chmod 600.

# Listen address. Keep 127.0.0.1 for local use; set a LAN or Tailscale
# address (or 0.0.0.0) to serve other machines. A non-loopback address
# requires EARS_LLM_API_KEY.
EARS_LLM_HOST=127.0.0.1
EARS_LLM_PORT=13279

# Bearer key clients must send. Generate one with: openssl rand -hex 32
EARS_LLM_API_KEY=

# Model catalog. Defaults to ~/.config/ears-llm/models.toml if present, else
# /usr/share/ears-llm/models.toml.
#EARS_LLM_MODELS=

# Where downloaded models go (default ~/.local/share/ears-llm/models).
# Files already in the Hugging Face cache are used in place.
#EARS_LLM_MODELS_DIR=

# Use the GPU through whichever ggml backend is installed (ggml-cuda,
# ggml-vulkan, ...). Set to 0 to force CPU.
EARS_LLM_GPU=1
