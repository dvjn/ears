# ears-stt settings. Copy to ~/.config/ears-stt/env and chmod 600.

# Listen address. Keep 127.0.0.1 for local use; set a LAN or Tailscale
# address (or 0.0.0.0) to serve other machines. A non-loopback address
# requires EARS_STT_API_KEY.
EARS_STT_HOST=127.0.0.1
EARS_STT_PORT=13278

# Bearer key clients must send. Generate one with: openssl rand -hex 32
EARS_STT_API_KEY=

# Model loaded at startup; requests may name any id from GET /v1/models.
# Files are downloaded on first use into EARS_STT_MODELS_DIR
# (default ~/.local/share/ears-stt/models).
EARS_STT_MODEL=whisper-medium.en
#EARS_STT_MODELS_DIR=

# Use the GPU through whichever ggml backend is installed (ggml-cuda,
# ggml-vulkan, ...). Set to 0 to force CPU.
EARS_STT_GPU=1

# Skip non-speech with whisper.cpp's Silero VAD before decoding (avoids
# hallucinated "thank you" on silence).
EARS_STT_VAD=1
