[Unit]
Description=ears-stt speech-to-text server
Documentation=https://github.com/dvjn/ears
After=network-online.target
Wants=network-online.target

[Service]
# Ready once the default model is loaded and the port is bound.
Type=notify
NotifyAccess=main
EnvironmentFile=-%h/.config/ears-stt/env
ExecStart=/usr/bin/ears-stt
Restart=on-failure
RestartSec=5
# The first start downloads the model.
TimeoutStartSec=600

[Install]
WantedBy=default.target
