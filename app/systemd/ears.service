[Unit]
Description=ears voice dictation (tray app)
Documentation=https://github.com/dvjn/ears
PartOf=graphical-session.target
After=graphical-session.target
Requisite=graphical-session.target

[Service]
# Runs in the tray; `ears toggle` from a hotkey talks to this instance.
ExecStart=/usr/bin/ears
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
